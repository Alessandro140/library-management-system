<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create_authors_tables" author="Alessandro">
        <comment>Creazione tabella authors con created_at e updated_at (Postgres)</comment>

        <createTable tableName="authors">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="firstName" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="lastName" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="birthDate" type="date">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="authors"/>
        </rollback>
    </changeSet>


    <changeSet id="002-create_books_tables" author="Alessandro">
        <createTable tableName="books">
            <column name="id" type="BIGSERIAL" autoIncrement="true" >
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT">
            </column>

            <column name="ISBN" type="varchar(13)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="authorId" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_books_authors" references="authors(id)"/>
            </column>

            <column name="published_date" type="date">
                <constraints nullable="false"/>
            </column>

            <column name="total_copies" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="available_copies" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="books"/>
        </rollback>
    </changeSet>


    <changeSet id="003-create_categories_tables" author="Alessandro">
        <createTable tableName="categories">
            <column name="id" type="BIGSERIAL" autoIncrement="true" >
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT">
            </column>

            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="categories"/>
        </rollback>
    </changeSet>


    <changeSet id="004-create_book_category_tables" author="Alessandro">
        <createTable tableName="book_category">
            <column name="book_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="book_category"
                    columnNames="book_id,category_id"
                    constraintName="pk_books_categories"/>

        <addForeignKeyConstraint baseTableName="book_category"
                                baseColumnNames="book_id"
                                constraintName="fk_book_category_book"
                                referencedTableName="books"
                                referencedColumnNames="id"
                                onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="book_category"
                                baseColumnNames="category_id"
                                constraintName="fk_book_category_category"
                                referencedTableName="categories"
                                referencedColumnNames="id"
                                onDelete="CASCADE"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="book_category"
                                    constraintName="fk_book_category_book"/>
            <dropForeignKeyConstraint baseTableName="book_category"
                                    constraintName="fk_book_category_category"/>
            <dropTable tableName="book_category"/>
        </rollback>
    </changeSet>


    <changeSet id="005-create_users_tables" author="Alessandro">
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL" autoIncrement="true" >
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="username" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="role" type="varchar(50)" defaultValue = "USER">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="users"/>
        </rollback>
    </changeSet>


    <changeSet id="006-create_loans_tables" author="Alessandro">
        <createTable tableName="loans">
            <column name="id" type="BIGSERIAL" autoIncrement="true" >
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="userId" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_loans_users" references="users(id)"/>
            </column>

            <column name="loanDate" type="date">
                <constraints nullable="false"/>
            </column>

            <column name="dueDate" type="date">
                <constraints nullable="false" />
            </column>

            <column name="status" type="varchar(50)" defaultValue = "ONGOING">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="loans"/>
        </rollback>
    </changeSet>

    <changeSet id="007-create_loans_book_tables" author="Alessandro">
        <createTable tableName="loans_book">
            <column name="loan" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="book" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="loans_book"
                    columnNames="loan,book"
                    constraintName="pk_loans_books"/>

        <addForeignKeyConstraint baseTableName="loans_book"
                                baseColumnNames="book"
                                constraintName="fk_loans_book_book"
                                referencedTableName="books"
                                referencedColumnNames="id"
                                onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="loans_book"
                                baseColumnNames="loan"
                                constraintName="fk_loans_book_loan"
                                referencedTableName="loans"
                                referencedColumnNames="id"
                                onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="loans_book"
                                    constraintName="fk_loans_book_book"/>
            <dropForeignKeyConstraint baseTableName="loans_book"
                                    constraintName="fk_loans_book_loan"/>
            <dropTable tableName="loans_book"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
