<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-add_authors" author="Alessandro">
        <insert tableName="authors">
            <column name="first_name" value="John"/>
            <column name="last_name" value="Doe"/>
            <column name="birth_date" value="1970-01-01"/>
        </insert>
        <insert tableName="authors">
            <column name="first_name" value="Jane"/>
            <column name="last_name" value="Smith"/>
            <column name="birth_date" value="1980-05-15"/>
        </insert>
    </changeSet>


    <changeSet id="002-add_books" author="Alessandro">
        <insert tableName="books">
            <column name="title" value="Sample Book 1"/>
            <column name="description" value="This is a sample book description."/>
            <column name="isbn" value="1234567890123"/>
            <column name="author_id" valueNumeric="1"/>
            <column name="published_date" value="2000-01-01"/>
            <column name="total_copies" valueNumeric="5"/>
            <column name="available_copies" valueNumeric="5"/>
        </insert>
        <insert tableName="books">
            <column name="title" value="Sample Book 2"/>
            <column name="isbn" value="0000000000000"/>
            <column name="author_id" valueNumeric="2"/>
            <column name="published_date" value="2000-01-01"/>
            <column name="total_copies" valueNumeric="3"/>
            <column name="available_copies" valueNumeric="1"/>
        </insert>
    </changeSet>


    <changeSet id="003-add_categories" author="Alessandro">
        <insert tableName="categories">
            <column name="name" value="Fiction"/>
        </insert>
        <insert tableName="categories">
            <column name="name" value="Non-Fiction"/>
            <column name="description" value="Books that are based on real events or facts."/>
        </insert>
    </changeSet>


    <changeSet id="004-add_book_category" author="Alessandro">
        <insert tableName="book_category">
            <column name="book_id" valueNumeric="1"/>
            <column name="category_id" valueNumeric="1"/>
        </insert>
        <insert tableName="book_category">
            <column name="book_id" valueNumeric="2"/>
            <column name="category_id" valueNumeric="2"/>
        </insert>
    </changeSet>


    <changeSet id="005-add_users" author="Alessandro">
        <insert tableName="users">
            <column name="username" value="user1"/>
            <column name="password" value="password1"/>
            <column name="email" value="user1@gmail.com"/>
        </insert>
        <insert tableName="users">
            <column name="username" value="user2"/>
            <column name="password" value="password2"/>
            <column name="email" value="user2@gmail.com"/>
            <column name="role" value="ADMIN"/>
        </insert>
    </changeSet>


    <changeSet id="006-add_loans" author="Alessandro">
        <insert tableName="loans">
            <column name="user_id" valueNumeric="1"/>
            <column name="loan_date" value="2023-01-01"/>
            <column name="due_date" value="2023-01-15"/>
        </insert>
        <insert tableName="loans">
            <column name="user_id" valueNumeric="2"/>
            <column name="loan_date" value="2023-02-01"/>
            <column name="due_date" value="2023-02-15"/>
        </insert>
    </changeSet>
</databaseChangeLog>
